+++ b/test/phone.test.js
@@ -0,0 +1,14 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { normalizePhone } from "../src/phone.js";
+
+test("normalizes common US formats", () => {
+  for (const raw of ["555-123-4567", "(555) 123-4567", "555.123.4567", "5551234567", "1-555-123-4567", "+1 555 123 4567"]) {
+    assert.equal(normalizePhone(raw), "+15551234567");
+  }
+});
+
+test("rejects other numbers", () => {
+  assert.throws(() => normalizePhone("555-1234"), RangeError);
+  assert.throws(() => normalizePhone("+44 20 7946 0958"), RangeError);
+});
