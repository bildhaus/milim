  * books, so the same person often appears more than once with the phone
@@ -8,3 +10,37 @@
 export function sortContacts(list) {
   return [...list].sort((a, b) => a.name.localeCompare(b.name));
 }
+
+function phoneKey(phone) {
+  try {
+    return normalizePhone(phone);
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Drop later contacts whose phone normalizes to an earlier contact's number,
+ * filling a missing email from the first later duplicate that has one.
+ * Contacts with an unparseable phone are kept unchanged.
+ */
+export function dedupeContacts(list) {
+  const firstByPhone = new Map();
+  const result = [];
+  for (const contact of list) {
+    const key = phoneKey(contact.phone);
+    if (key === null) {
+      result.push(contact);
+      continue;
+    }
+    const first = firstByPhone.get(key);
+    if (!first) {
+      const kept = { ...contact };
+      firstByPhone.set(key, kept);
+      result.push(kept);
+    } else if (!first.email && contact.email) {
+      first.email = contact.email;
+    }
+  }
+  return result;
+}
diff --git a/src/phone.js b/src/phone.js
new file mode 100644
index 0000000..ba76155
--- /dev/null
+++ b/src/phone.js
@@ -0,0 +1,16 @@
+/**
+ * Normalize a US phone number to E.164 (`+15551234567`). Accepts the usual
+ * separators (spaces, dashes, dots, parentheses) and an optional leading
+ * country code 1; anything else throws a RangeError.
+ */
+export function normalizePhone(raw) {
+  if (typeof raw !== "string" || !/^[\d\s().+-]+$/.test(raw)) {
+    throw new RangeError(`not a US phone number: ${raw}`);
+  }
+  let digits = raw.replace(/\D/g, "");
+  if (digits.length === 11 && digits.startsWith("1")) digits = digits.slice(1);
+  if (digits.length !== 10) {
+    throw new RangeError(`not a US phone number: ${raw}`);
+  }
+  return `+1${digits}`;
+}
