+
+test("dedupeContacts merges contacts by normalized phone", async () => {
+  const { dedupeContacts } = await import("../src/contacts.js");
+  const result = dedupeContacts([
+    { name: "Ann", phone: "555-123-4567" },
+    { name: "Ann B.", phone: "+1 555 123 4567", email: "ann@x.io" },
+    { name: "Nobody", phone: "n/a" },
+  ]);
+  assert.deepEqual(result, [
+    { name: "Ann", phone: "555-123-4567", email: "ann@x.io" },
+    { name: "Nobody", phone: "n/a" },
+  ]);
+});
