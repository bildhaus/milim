diff --git a/src/query.js b/src/query.js
index 4740ea0..bd09290 100644
--- a/src/query.js
+++ b/src/query.js
@@ -1,3 +1,10 @@
+const RANK = { high: 0, normal: 1, low: 2 };
+
 export function openTasks(tasks) {
   return tasks.filter((task) => !task.done);
 }
+
+/** A new array ordered high, normal, low; ties keep their input order. */
+export function sortByPriority(tasks) {
+  return [...tasks].sort((a, b) => RANK[a.priority ?? "normal"] - RANK[b.priority ?? "normal"]);
+}
