diff --git a/test/priority.test.js b/test/priority.test.js
new file mode 100644
index 0000000..cea0c73
--- /dev/null
+++ b/test/priority.test.js
@@ -0,0 +1,24 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { addTask, createStore } from "../src/store.js";
+import { sortByPriority } from "../src/query.js";
+import { run } from "../src/cli.js";
+
+test("priority defaults to normal and is validated", () => {
+  const store = createStore();
+  assert.equal(addTask(store, "a").priority, "normal");
+  assert.throws(() => addTask(store, "b", { priority: "urgent" }), RangeError);
+});
+
+test("sortByPriority is stable and pure", () => {
+  const tasks = [{ id: 1, priority: "low" }, { id: 2, priority: "high" }, { id: 3, priority: "high" }];
+  assert.deepEqual(sortByPriority(tasks).map((task) => task.id), [2, 3, 1]);
+  assert.deepEqual(tasks.map((task) => task.id), [1, 2, 3]);
+});
+
+test("cli priority flags", () => {
+  const store = createStore();
+  run(store, ["add", "--priority=low", "Dust"]);
+  run(store, ["add", "Pay", "--priority=high"]);
+  assert.deepEqual(run(store, ["list", "--sort=priority"]), ["2. [!] Pay", "1. [-] Dust"]);
+});
