+++ b/tests/title-case.test.js
@@ -0,0 +1,12 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { titleCase } from "../src/index.js";
+
+test("capitalizes words split by spaces and hyphens", () => {
+  assert.equal(titleCase("hello WORLD-wide"), "Hello World-Wide");
+  assert.equal(titleCase("  two  spaces "), "  Two  Spaces ");
+});
+
+test("rejects non-strings", () => {
+  assert.throws(() => titleCase(7), TypeError);
+});
