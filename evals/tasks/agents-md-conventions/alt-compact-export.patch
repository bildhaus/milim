+++ b/src/title-case.js
@@ -0,0 +1,15 @@
+/**
+ * Capitalize the first letter of every space- or hyphen-separated word.
+ *
+ * @param {string} text - Input text.
+ * @returns {string} The text in title case.
+ * @example
+ * titleCase("hello WORLD-wide"); // "Hello World-Wide"
+ */
+export const titleCase = (text) => {
+  if (typeof text !== "string") throw new TypeError("text must be a string");
+  return text
+    .split(/([\s-]+)/)
+    .map((part) => (/^[\s-]*$/.test(part) ? part : part[0].toUpperCase() + part.slice(1).toLowerCase()))
+    .join("");
+};
diff --git a/tests/title-case.test.js b/tests/title-case.test.js
new file mode 100644
