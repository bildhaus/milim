+++ b/src/title-case.js
@@ -0,0 +1,15 @@
+/**
+ * Capitalize the first letter of every word and lowercase the rest. Words
+ * are separated by spaces or hyphens, and the original spacing is kept.
+ *
+ * @param {string} text - Input text.
+ * @returns {string} The text in title case.
+ * @example
+ * titleCase("hello WORLD-wide"); // "Hello World-Wide"
+ */
+export function titleCase(text) {
+  if (typeof text !== "string") {
+    throw new TypeError("text must be a string");
+  }
+  return text.toLowerCase().replace(/(^|[\s-])(\p{L})/gu, (_, before, letter) => `${before}${letter.toUpperCase()}`);
+}
diff --git a/tests/title-case.test.js b/tests/title-case.test.js
