+
+/** Parse a v2 config: `{ "version": 2, "server": { host, port }, "features": [] }`. */
+export function loadConfigV2(text) {
+  const document = JSON.parse(text);
+  if (document?.version !== 2) {
+    throw new Error("config version must be 2");
+  }
+  const server = document.server ?? {};
+  return {
+    host: server.host ?? DEFAULTS.host,
+    port: validPort(server.port ?? DEFAULTS.port),
+    features: [...(document.features ?? DEFAULTS.features)],
+  };
+}
+
+/** Load either config format; v2 is detected by a leading `{`. */
+export function loadConfig(text) {
+  return text.trimStart().startsWith("{") ? loadConfigV2(text) : loadConfigV1(text);
+}
diff --git a/src/migrate.js b/src/migrate.js
new file mode 100644
index 0000000..7392c16
--- /dev/null
+++ b/src/migrate.js
@@ -0,0 +1,7 @@
+import { loadConfigV1 } from "./config.js";
+
+/** Convert a v1 config document to the equivalent v2 JSON text. */
+export function migrateV1ToV2(text) {
+  const { host, port, features } = loadConfigV1(text);
+  return `${JSON.stringify({ version: 2, server: { host, port }, features }, null, 2)}\n`;
+}
diff --git a/test/v2.test.js b/test/v2.test.js
new file mode 100644
index 0000000..c6bdf00
--- /dev/null
+++ b/test/v2.test.js
@@ -0,0 +1,20 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { loadConfig } from "../src/config.js";
+import { migrateV1ToV2 } from "../src/migrate.js";
+
+test("loads v2", () => {
+  const text = JSON.stringify({ version: 2, server: { host: "h", port: 81 }, features: ["a"] });
+  assert.deepEqual(loadConfig(`\n ${text}`), { host: "h", port: 81, features: ["a"] });
+});
+
+test("rejects bad ports in both formats", () => {
+  assert.throws(() => loadConfig("port = 0"), RangeError);
+  assert.throws(() => loadConfig('{"version":2,"server":{"host":"h","port":65536},"features":[]}'), RangeError);
+});
+
+test("migrateV1ToV2 keeps values", () => {
+  const migrated = migrateV1ToV2("host = a\nport = 2\nfeatures = x\n");
+  assert.equal(migrated, `${JSON.stringify({ version: 2, server: { host: "a", port: 2 }, features: ["x"] }, null, 2)}\n`);
+  assert.deepEqual(loadConfig(migrated), loadConfig("host = a\nport = 2\nfeatures = x\n"));
+});
