diff --git a/src/users.js b/src/users.js
index 957b061..0deac2d 100644
--- a/src/users.js
+++ b/src/users.js
@@ -1,12 +1,20 @@
 let nextId = 1;
+const ROLES = new Set(["admin", "member"]);
 
 export function resetIds() {
   nextId = 1;
 }
 
-export function createUser(name, email, isAdmin = false) {
-  if (!name || !email.includes("@")) {
+export function createUser(options) {
+  if (options === null || typeof options !== "object" || Array.isArray(options)) {
+    throw new TypeError("createUser expects an options object");
+  }
+  const { name, email, role = "member" } = options;
+  if (!ROLES.has(role)) {
+    throw new RangeError(`unknown role: ${role}`);
+  }
+  if (!name || typeof email !== "string" || !email.includes("@")) {
     throw new Error("invalid user");
   }
-  return { id: nextId++, name: name.trim(), email: email.toLowerCase(), isAdmin };
+  return { id: nextId++, name: name.trim(), email: email.toLowerCase(), role };
 }
