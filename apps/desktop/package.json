{
  "name": "milim-desktop",
  "private": true,
  "version": "0.2.70",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node --env-file-if-exists=../../.env.local node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "node --env-file-if-exists=../../.env.local node_modules/@tauri-apps/cli/tauri.js dev --additional-watch-folders ../../../crates",
    "test": "node tests/run-tests.mjs",
    "test:copy": "node tests/copy-lint.test.mjs",
    "test:brand-cleanup": "node tests/brand-cleanup.test.mjs",
    "test:selectors": "node tests/zustand-selector-lint.test.mjs",
    "test:media:frontend": "node tests/run-tests.mjs generated-media-rendering",
    "test:media": "npm run test:media:frontend && cargo test --manifest-path ../../Cargo.toml -p milim-server media_",
    "test:mobile-companion:frontend": "node tests/run-tests.mjs mobile-tailscale-status",
    "test:mobile-companion": "npm run test:mobile-companion:frontend && cargo test --manifest-path ../../Cargo.toml -p milim-server mobile_companion",
    "test:artifacts:frontend": "node tests/run-tests.mjs artifact browser-recent-visits google-workspace markdown-rendering preview-panel-rendering",
    "test:artifacts": "npm run test:artifacts:frontend && node tests/run-tauri-rust-test.mjs artifact_",
    "test:tauri-config": "node tests/tauri-config.test.mjs",
    "test:computer-use": "node tests/run-tauri-rust-test.mjs computer_use",
    "test:tauri-dev-onboarding": "node tests/tauri-dev-onboarding-e2e.mjs",
    "test:tauri-webview": "node tests/tauri-webview-e2e.mjs",
    "test:tauri-command-palette": "node tests/tauri-webview-e2e.mjs --command-palette-only",
    "test:tauri-generation-controls": "node tests/tauri-webview-e2e.mjs --generation-controls-only",
    "test:tauri-harness-hardening": "node tests/tauri-webview-e2e.mjs --harness-hardening-only",
    "test:tauri-inbox-sidebar": "node tests/tauri-webview-e2e.mjs --inbox-sidebar-only",
    "test:tauri-linked-thread-drop": "node tests/tauri-webview-e2e.mjs --linked-thread-drop-only",
    "test:tauri-window-close": "node tests/tauri-webview-e2e.mjs --window-close-only",
    "test:tauri-settings": "node tests/tauri-webview-e2e.mjs --settings-only",
    "test:tauri-composer-controls": "node tests/tauri-webview-e2e.mjs --composer-controls-only",
    "test:tauri-schedules": "node tests/tauri-webview-e2e.mjs --schedules-only",
    "test:tauri-source-hover": "node tests/tauri-webview-e2e.mjs --source-hover-only",
    "test:tauri-turn-changes": "node tests/tauri-webview-e2e.mjs --turn-changes-only",
    "test:tauri-resize-handles": "node tests/tauri-webview-e2e.mjs --resize-handles-only",
    "test:tauri-worker-preview": "node tests/tauri-webview-e2e.mjs --worker-preview-tab-only",
    "test:tauri-mcp-apps": "node tests/tauri-webview-e2e.mjs --mcp-apps-only",
    "perf:tauri-dev": "node tests/tauri-dev-perf.mjs",
    "perf:release-build": "npm run tauri -- build --no-bundle --features perf-diagnostics",
    "perf:canonical": "npm run perf:release-build && node tests/tauri-dev-perf.mjs --binary",
    "perf:suite": "npm run perf:release-build && node tests/tauri-perf-suite.mjs",
    "perf:suite:enforce": "npm run perf:release-build && node tests/tauri-perf-suite.mjs --enforce",
    "verify:runtime-conformance": "node tests/runtime-conformance.mjs",
    "verify:control-contract": "cargo run --manifest-path ../../Cargo.toml -p milim-control-contract --bin generate-control-contract -- --check",
    "package:release": "node scripts/package-release.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "verify:release-manifest": "node scripts/verify-release-manifest.mjs",
    "verify:release-notes": "node scripts/generate-release-notes.mjs --check",
    "verify:release-workflow": "node scripts/verify-release-workflow.mjs && node tests/release-manifest-merge.test.mjs",
    "release:portable": "node scripts/stage-portable-release-artifact.mjs",
    "verify:release": "npm run package:release && npm run release:portable && npm run release:manifest && npm run verify:release-manifest && npm run verify:release-launch",
    "verify:release-launch": "node scripts/smoke-release-binary.mjs",
    "verify:bundle-size": "node scripts/verify-bundle-size.mjs",
    "verify:lockfile-drift": "node scripts/verify-lockfile-drift.mjs",
    "verify:frontend": "npm run build && npm run verify:bundle-size && npm run test && npm run verify:release-notes && npm run verify:release-workflow",
    "verify:native-tests": "cargo test --manifest-path ../../Cargo.toml -p milim-server media_ && cargo test --manifest-path ../../Cargo.toml -p milim-server mobile_companion && node tests/run-tauri-rust-test.mjs artifact_ && node tests/run-tauri-rust-test.mjs backup::tests && npm run test:computer-use",
    "verify": "npm run verify:control-contract && npm run verify:frontend && npm run verify:native-tests",
    "verify:tauri": "node tests/run-tauri-smoke.mjs",
    "verify:tauri-webview": "npm run verify:tauri && npm run test:tauri-webview && npm run test:tauri-worker-preview",
    "verify:tester-ready": "npm run verify && npm run verify:release && npm run verify:tauri-webview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@oshtz/shatz-avatars": "file:vendor/oshtz-shatz-avatars-0.1.0.tgz",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "codemirror": "^6.0.2",
    "cuelume": "0.1.2",
    "highlight.js": "^11.11.1",
    "js-tiktoken": "^1.0.21",
    "lowlight": "^3.3.0",
    "mermaid": "^11.16.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.6.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.60.0",
    "vite": "^6.4.3"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.17",
      "browserslist": "4.28.9",
      "fast-uri": "3.1.6",
      "hono": "4.13.2",
      "ip-address": "10.5.0",
      "nanoid": "3.3.18",
      "postcss": "8.5.26",
      "qs": "6.16.0"
    }
  }
}
